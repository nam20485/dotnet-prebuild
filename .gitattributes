# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Windows scripts should always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docker files should use LF
Dockerfile* text eol=lf
*.dockerfile text eol=lf

# YAML files should use LF
*.yml text eol=lf
*.yaml text eol=lf

# JSON files should use LF
*.json text eol=lf

# Markdown files should use LF
*.md text eol=lf

# C# files
*.cs text diff=csharp
*.csproj text eol=lf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
